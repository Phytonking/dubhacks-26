# MongoDB connection string (Atlas, or run `pnpm db:local` and use the URI it prints)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=salesagent

# Photon Project API key (pho_sk_...). Platform secret: Worker + Voice Gateway only, never sent into sandboxes.
# Bound to ONE project; accepted only on https://api.photon.codes/v1/projects/{PHOTON_PROJECT_ID}/...
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# Daytona (Orchestrator only)
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=
# LLM inference on Modal (platform secret: LLM gateway only, never sent into sandboxes)
MODAL_API_ENDPOINT=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
# Sent into sandboxes: our LLM gateway URL (not Modal) and the model id
LLM_BASE_URL=
LLM_MODEL=Qwen/Qwen3.8-2.4T-A95B

# Photon webhook destination (https://api.photon.codes/v1/projects/{id}/webhooks/destinations)
# Signing secret (whsec_...) is returned ONCE when the destination is created. Platform secret: never sent into sandboxes.
PHOTON_WEBHOOK_SIGNING_SECRET=
# Previous secret during a rotation overlap (optional)
PHOTON_WEBHOOK_PREVIOUS_SECRET=
# Local port for the webhook receiver in `pnpm live` (optional; needs a public HTTPS URL pointing at it)
PHOTON_WEBHOOK_PORT=
# Throwaway inspector URL (e.g. webhook.site) used while testing; not read by code
PHOTON_WEBHOOK_INSPECTOR_URL=
