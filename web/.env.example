# MongoDB connection string (Atlas, or run `pnpm db:local` and use the URI it prints)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=salesagent

# Photon Project API key (pho_sk_...). Platform secret: Worker + Voice Gateway only, never sent into sandboxes.
# Bound to ONE project; accepted only on https://api.photon.codes/v1/projects/{PHOTON_PROJECT_ID}/...
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# Daytona (Orchestrator only)
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=
# LLM inference on Modal (platform secret: LLM gateway only, never sent into sandboxes)
MODAL_API_ENDPOINT=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
# Sent into sandboxes: our LLM gateway URL (not Modal) and the model id
LLM_BASE_URL=
LLM_MODEL=Qwen/Qwen3.8-2.4T-A95B

# Photon webhook destination (https://api.photon.codes/v1/projects/{id}/webhooks/destinations)
# Signing secret (whsec_...) is returned ONCE when the destination is created. Platform secret: never sent into sandboxes.
PHOTON_WEBHOOK_SIGNING_SECRET=
# Previous secret during a rotation overlap (optional)
PHOTON_WEBHOOK_PREVIOUS_SECRET=
# Local port for the webhook receiver in `pnpm live` (optional; needs a public HTTPS URL pointing at it)
PHOTON_WEBHOOK_PORT=
# Throwaway inspector URL (e.g. webhook.site) used while testing; not read by code
PHOTON_WEBHOOK_INSPECTOR_URL=

# Primary test user (E.164). Used by `pnpm db:seed` and scripts/migrate-primary-user.mts to tie the tester's number to the seeded contact and owner user.
PRIMARY_TEST_PHONE=

# T-Mobile sandbox import (pnpm db:seed:tmobile): path to dubhacks/data/sandbox.db
TMO_DB_PATH=

# --- Agent engine (agent/) and secure forms (web/) ---
# Secret for hashing one-time verification codes (any long random string). Required by the agent for verify_send_code.
VERIFY_HMAC_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts sensitive form answers. Without it forms refuse to submit.
FORM_ENC_KEY=
# Password for the owner's form-answers screen (/forms). If unset, viewing and revealing answers is OFF.
FORMS_ADMIN_PASSWORD=
# Public base URL used in secure-form links texted to customers (no trailing slash). Must be your own domain, not a link shortener.
PUBLIC_FORMS_BASE_URL=http://localhost:3000
# Voice server (agent/): secret path segment for the ElevenLabs Custom LLM URL, and the ElevenLabs post-call webhook secret.
VOICE_PATH_SECRET=
ELEVENLABS_WEBHOOK_SECRET=
VOICE_PORT=8787
# When a caller on the phone needs to continue by text, give them an iMessage line to text (assigned on request). 0 = off. Cap = max assignments to use.
AUTO_ASSIGN_IMESSAGE=
IMESSAGE_ASSIGN_CAP=20
# WhatsApp replies are off until this is 1. Needed for the "message us on WhatsApp" option to work end to end.
WHATSAPP_REPLIES=
